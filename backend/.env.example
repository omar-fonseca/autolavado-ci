PORT=3000
NODE_ENV=development
DB_HOST=db
DB_PORT=3306
DB_USER=autolavado_app
DB_PASSWORD=replace-with-app-password
DB_NAME=autolavado_db
DB_POOL_LIMIT=10
DB_POOL_MAX_IDLE=5

# Credenciales para npm run db:migrate y la auto-migracion al arrancar.
MIGRATION_DB_USER=autolavado_migrator
MIGRATION_DB_PASSWORD=replace-with-migration-password

# En desarrollo/CI dejar vacio para permitir Frontend y POST /api/verify sin 401.
# Produccion requiere una clave aleatoria de al menos 32 bytes y origenes explicitos.
API_WRITE_KEY=
CORS_ORIGINS=http://localhost:5173
WRITE_RATE_LIMIT=60